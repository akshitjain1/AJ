# ─────────────────────────────────────────────────────────────
#  AI Portfolio Assistant — server-side configuration
#  Copy to .env (or .env.local) for local development. On Vercel, add these
#  under Project → Settings → Environment Variables. Never prefix them with
#  NEXT_PUBLIC_, which would ship them to the browser.
#  At least one provider key is required.
# ─────────────────────────────────────────────────────────────

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# Optional. Comma-separated models, tried in order.
# Defaults to gemini-flash-lite-latest,gemini-flash-latest.
GEMINI_MODEL=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
# Optional. Comma-separated models, tried in order. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# xAI Grok (https://console.x.ai). GROK_API_KEY / GROK_MODEL are accepted as aliases.
XAI_API_KEY=
# Optional. Defaults to grok-3-mini.
XAI_MODEL=

# Optional. The first configured provider answers. The next one is tried only
# if it fails (timeout, rate limit, server error). Default: gemini,groq,xai
CHAT_PROVIDER_ORDER=gemini,groq,xai

# Optional. Upper bound on reply length in tokens. Default: 700 (max 2048)
CHAT_MAX_OUTPUT_TOKENS=700

# ── Abuse & cost protection (all optional) ──
# Emergency kill switch: false = refuse every request without calling a model.
CHAT_ENABLED=true
# Per-visitor limits (HTTP 429 when exceeded).
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_HOUR=30
CHAT_RATE_PER_DAY=60
CHAT_MAX_CONCURRENT=2
CHAT_MAX_MESSAGE_CHARS=2000
# Model calls per UTC day across all visitors (0 = unlimited).
CHAT_DAILY_BUDGET=500
# Model calls per question (1 = no fallback, 2 = one fallback if the first fails before answering).
CHAT_MAX_ATTEMPTS=2

# Shared counters so the limits above hold across all Vercel instances.
# Added automatically by Vercel's Upstash for Redis integration (free plan).
# Without them, limits are counted per serverless instance (best-effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
